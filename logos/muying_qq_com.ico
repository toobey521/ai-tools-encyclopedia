      var size = 75;
      $('.hide-wrap .li-sec').hover(
        function() {
          var span = $(this).find('.hide-span');
          if (span && span.length) {
            $(span).text($(span).attr('data'))
          }
        },
        function() {
          var span = $(this).find('.hide-span');
          if (span && span.length) {
            var data = $(span).attr('data');
            if (data.length > size) {
              $(span).text(data.substr(0, size) + '...')
            }
          }
        }
      );
      $('.hide-span').each(function() {
        var data = $(this).attr('data');
        if (data.length > size) {
          $(this).text(data.substr(0, size) + '...')
